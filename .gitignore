# 密钥与环境（绝不进仓库）
.env
*.env
.env.*

# 会话缓存与运行时中间产物
.state/
*.parquet
__pycache__/
*.pyc
.pytest_cache/

# 真实薪资数据（仅允许 data/ 下的脱敏样例；private 不跟踪）
data/private/

# 运行期产物（工具每次跑都会重新生成，进仓库只会造成「污染」+ 真实薪资泄漏）
#   report/薪酬诊断报告_YYYYMMDD_HHMMSS.{md,html} —— 报告导出
#   data/band_YYYYMMDD_HHMMSS.csv                 —— 带宽表导出
#   assets/*.html                                 —— 图表（内嵌真实薪资数值，每次重生成，
#                                                    绝不入库，避免历史运行的真实数据被提交）
report/*.md
report/*.html
data/band_*.csv
assets/*.html
!assets/.gitkeep

# ⚠️ 安全红线：src/data/ 是 increase 明细导出目录（increase.py::_export_detail），
#    文件含 monthly_salary / new_monthly_salary 等**行级薪资明细**，
#    与「报告不得出现行级真实薪资明细」同一纪律 —— 一律不得进仓库。
src/data/

# 临时探针脚本及其输出（调试用，勿入库）
# 必须以 / 锚定仓库根目录：裸写 _*.py 会连带匹配所有层级的 __init__.py。
/_*.py
/_*.txt
/__*.txt

# 编辑器/系统
.vscode/
.idea/
.DS_Store
tests/_out/
.state/

# ---------------------------------------------------------------------------
# dsh 插件层（src/plugins/comp-tool/）—— 与金标准 dsh-excel-kit 同口径
# ---------------------------------------------------------------------------
# node 依赖：插件层 node_modules 里装的是 @deepseek-ai/* 契约包，绝不入库。
node_modules/

# 构建产物：package.json 的 main 指向 lib/index.js，由 `npm run build` 产出
# （prepublishOnly 也会跑）。入库会造成源码与产物不同步的噪音。
src/plugins/comp-tool/lib/
*.tsbuildinfo

# MCP 客户端本机配置（含机器专属绝对路径，仅本机用，绝不入库；
# 模板见 .mcp.json.example，可提交）。
/.mcp.json
