{
  "name": "dsh-comp-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CCO Copilot：11 个薪酬诊断工具的 dsh Cordis 插件层（TS 插件 + Python 计算核心）",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "gen:schemas": "python ../../../tools/gen_plugin_schemas.py",
    "test": "npm run build && node src/__tests__/frame.test.mjs && node src/__tests__/params-alignment.mjs && node src/__tests__/definetool-probe.mjs && node src/__tests__/worker-e2e.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
